# Copy to .env and fill in. .env is gitignored and never committed.
#
# Generate both keys with:
#   openssl rand -hex 32

# Signs JWTs. Changing it invalidates every existing session, which is the
# intended way to force everyone to sign in again.
DATAMETRONOME_SECRET_KEY=

# Encrypts stave connection credentials at rest, via Fernet.
#
# Set this separately from SECRET_KEY. When it is empty the Fernet key is
# derived from SECRET_KEY instead, which means rotating the JWT key silently
# makes every stored credential undecryptable and every check fails with
# InvalidToken. Keeping them separate lets you rotate sessions freely.
#
# Rotating THIS key requires re-encrypting existing staves. There is no
# migration for that yet, so treat it as set-once for now.
DATAMETRONOME_ENCRYPTION_KEY=

# Minutes a session lasts. There are no refresh tokens, so expiry means a
# redirect to the login page rather than a silent renewal.
DATAMETRONOME_ACCESS_TOKEN_EXPIRE_MINUTES=60

DATAMETRONOME_DATABASE_URL=postgresql://testuser:testpass@postgres:5432/datametronome_test
DATAMETRONOME_ALLOWED_ORIGINS=http://localhost:3000

# inline, celery, or remote. celery needs `make up-workers`; without a worker
# consuming the queue, dispatched checks are queued and never execute.
DATAMETRONOME_DISPATCH_MODE=celery
DATAMETRONOME_CELERY_BROKER_URL=amqp://guest:guest@rabbitmq:5672//
DATAMETRONOME_CELERY_RESULT_BACKEND=redis://redis:6379/0
DATAMETRONOME_REDIS_URL=redis://redis:6379/0

# anthropic, openai, gemini, or ollama. Ollama needs AI_BASE_URL set.
DATAMETRONOME_AI_PROVIDER=ollama
DATAMETRONOME_AI_MODEL=qwen2.5
DATAMETRONOME_AI_API_KEY=
DATAMETRONOME_AI_BASE_URL=http://host.docker.internal:11434/v1
