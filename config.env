# DataMetronome Configuration
# Modify these values as needed for your environment

# API Server Configuration
PODIUM_PORT=8000
PODIUM_HOST=0.0.0.0

# UI Configuration
UI_PORT=3000

# Database Configuration
DATAMETRONOME_SECRET_KEY=demo-secret-key-for-development-only
DATAMETRONOME_DATABASE_URL=sqlite+aiosqlite:///./data/datametronome.db

# Development/Production Mode
ENVIRONMENT=development
LOG_LEVEL=INFO

# CORS Configuration (comma-separated list)
# (Nuxt may auto-switch to 3001 if 3000 is busy)
DATAMETRONOME_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
