# DataMetronome Production Environment Variables
# 
# Copy this file to .env and update with your production values
# DO NOT commit .env to version control!

# =============================================================================
# CRITICAL SECURITY SETTINGS
# =============================================================================

# Secret key for JWT tokens (REQUIRED - must be 32+ characters)
# Generate with: openssl rand -hex 32
DATAMETRONOME_SECRET_KEY=your-super-secret-key-change-this-in-production

# PostgreSQL password (REQUIRED)
POSTGRES_PASSWORD=your-secure-postgres-password

# Redis password (REQUIRED)
REDIS_PASSWORD=your-secure-redis-password

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

POSTGRES_DB=datametronome
POSTGRES_USER=datametronome
POSTGRES_PORT=5432

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================

# Podium API
PODIUM_PORT=8000
LOG_LEVEL=INFO
ALLOWED_ORIGINS=https://yourdomain.com,https://app.yourdomain.com
TOKEN_EXPIRE_MINUTES=60

# UI
UI_PORT=8501

# Redis
REDIS_PORT=6379

# Scheduler
SCHEDULER_ENABLED=true
SCHEDULER_TIMEZONE=UTC

# =============================================================================
# MONITORING (Optional - only if using --profile monitoring)
# =============================================================================

PROMETHEUS_PORT=9090

# Grafana password (REQUIRED if using Grafana)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=your-secure-grafana-password
GRAFANA_ROOT_URL=https://grafana.yourdomain.com
GRAFANA_PLUGINS=

# =============================================================================
# DEPLOYMENT SETTINGS
# =============================================================================

# Docker resource limits
# Adjust based on your server capacity
#
# Current defaults:
# - Postgres: 2 CPU, 2GB RAM
# - Redis: 1 CPU, 512MB RAM
# - Podium: 2 CPU, 1GB RAM (x2 replicas)
# - UI: 1 CPU, 1GB RAM
# - Total: ~8 CPU, ~7GB RAM for full stack

# =============================================================================
# SSL/TLS CERTIFICATES (if using nginx profile)
# =============================================================================

# Place your SSL certificates in ./nginx/ssl/
# - fullchain.pem
# - privkey.pem

