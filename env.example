# DataMetronome Podium Environment Configuration

# Database (PostgreSQL is the default; SQLite supported as fallback)
DATAMETRONOME_DATABASE_URL=postgresql://testuser:testpass@localhost:5432/datametronome_test
# For SQLite fallback:
# DATAMETRONOME_DATABASE_URL=sqlite:///./data/datametronome.db

# Security
#
# Generate both keys with:  openssl rand -hex 32
# Do not leave the placeholders in place, and do not set SECRET_KEY per service
# in docker-compose.yml. The API, worker and beat all need the same value, and
# overriding it on one service is how they drift apart.

# Signs JWTs. Changing it invalidates every existing session.
DATAMETRONOME_SECRET_KEY=

# Encrypts stave connection credentials at rest, via Fernet.
#
# Set this separately from SECRET_KEY. When empty, the Fernet key is derived
# from SECRET_KEY instead, so rotating the JWT key silently makes every stored
# credential undecryptable and every check fails with InvalidToken.
#
# Rotating THIS key needs existing staves re-encrypted, and there is no
# migration for that yet. Treat it as set-once.
DATAMETRONOME_ENCRYPTION_KEY=

# Minutes a session lasts. There are no refresh tokens, so expiry means a
# redirect to the login page rather than a silent renewal.
DATAMETRONOME_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Server
DATAMETRONOME_HOST=0.0.0.0
DATAMETRONOME_PORT=8001
DATAMETRONOME_DEBUG=true

# CORS
DATAMETRONOME_ALLOWED_ORIGINS=http://localhost:3000

# Logging
# DATAMETRONOME_LOG_LEVEL=INFO

# Logfire observability (optional; when set, traces are sent to Logfire cloud)
# LOGFIRE_TOKEN=your-logfire-write-token

# Scheduler
# DATAMETRONOME_SCHEDULER_ENABLED=true
# DATAMETRONOME_SCHEDULER_TIMEZONE=UTC
# DATAMETRONOME_SCHEDULER_MAX_INSTANCES=3
# DATAMETRONOME_SCHEDULER_MAX_WORKERS=10

# Job Queue
# DATAMETRONOME_JOB_QUEUE_SIZE=1000
# DATAMETRONOME_WORKER_POOL_SIZE=4

# Metrics
# DATAMETRONOME_METRICS_ENABLED=true
# DATAMETRONOME_METRICS_RETENTION_DAYS=90

# AI Agent Configuration
# Provider: anthropic | openai | gemini | ollama (default: ollama)
DATAMETRONOME_AI_PROVIDER=ollama

# Model name for the main agents
DATAMETRONOME_AI_MODEL=qwen2.5

# API key (not needed for Ollama)
# DATAMETRONOME_AI_API_KEY=your-api-key-here

# Optional: cheaper/faster model for the routing step only
# DATAMETRONOME_AI_ROUTER_MODEL=claude-haiku-4-5

# Base URL (required for Ollama; optional for custom OpenAI-compatible endpoints)
# DATAMETRONOME_AI_BASE_URL=http://localhost:11434/v1

# Ollama API base (legacy — used when AI_PROVIDER=ollama and AI_BASE_URL is unset)
# OLLAMA_API_BASE=http://localhost:11434

# Examples for other providers:
# Anthropic (Claude):
#   DATAMETRONOME_AI_PROVIDER=anthropic
#   DATAMETRONOME_AI_MODEL=claude-sonnet-4-6
#   DATAMETRONOME_AI_API_KEY=sk-ant-...
#   DATAMETRONOME_AI_ROUTER_MODEL=claude-haiku-4-5

# OpenAI:
#   DATAMETRONOME_AI_PROVIDER=openai
#   DATAMETRONOME_AI_MODEL=gpt-4o
#   DATAMETRONOME_AI_API_KEY=sk-...

# Google Gemini:
#   DATAMETRONOME_AI_PROVIDER=gemini
#   DATAMETRONOME_AI_MODEL=gemini-1.5-flash
#   DATAMETRONOME_AI_API_KEY=your-gemini-key

# ─── Celery / Worker ───
# Dispatch mode: inline (no broker), celery (RabbitMQ)
DATAMETRONOME_DISPATCH_MODE=inline
# RabbitMQ broker URL
DATAMETRONOME_CELERY_BROKER_URL=amqp://guest:guest@rabbitmq:5672//
# Redis result backend
DATAMETRONOME_CELERY_RESULT_BACKEND=redis://redis:6379/0
# Redis URL (for cache + redbeat)
DATAMETRONOME_REDIS_URL=redis://redis:6379/0
# Celery worker concurrency
DATAMETRONOME_CELERY_CONCURRENCY=4
