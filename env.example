# DataMetronome Environment Configuration
# Copy this file to .env and update the values

# Core Configuration
DATAMETRONOME_DEBUG=true
DATAMETRONOME_LOG_LEVEL=INFO

# Server Configuration
DATAMETRONOME_HOST=0.0.0.0
DATAMETRONOME_PORT=8001

# Security (REQUIRED - Change this in production!)
DATAMETRONOME_SECRET_KEY=your-super-secret-key-change-this-in-production

# Database Configuration
# SQLite (default)
DATAMETRONOME_DATABASE_URL=sqlite:///./data/datametronome.db

# PostgreSQL (alternative)
# DATAMETRONOME_DATABASE_URL=postgresql+asyncpg://username:password@localhost:5432/datametronome

# Authentication
DATAMETRONOME_ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS Configuration
DATAMETRONOME_ALLOWED_ORIGINS=["http://localhost:3000", "http://localhost:8501"]

# Scheduler Configuration
DATAMETRONOME_SCHEDULER_ENABLED=true
DATAMETRONOME_SCHEDULER_TIMEZONE=UTC

# Job Queue Configuration
DATAMETRONOME_JOB_QUEUE_SIZE=1000
DATAMETRONOME_WORKER_POOL_SIZE=4

# Metrics Configuration
DATAMETRONOME_METRICS_ENABLED=true
DATAMETRONOME_METRICS_RETENTION_DAYS=90

# UI Configuration
DATAMETRONOME_BACKEND_URL=http://localhost:8001
DATAMETRONOME_UI_TITLE=DataMetronome
DATAMETRONOME_UI_THEME=light

# AI Agent / ADK Configuration
# For Ollama (recommended): Set model to ollama_chat/qwen2.5 (or your preferred model)
DATAMETRONOME_ADK_MODEL=ollama_chat/qwen2.5
# Ollama API base URL (for remote Ollama instances, e.g., http://192.168.0.35:11434)
# OLLAMA_API_BASE=http://localhost:11434

# For Gemini: Set model to gemini-2.0-flash-exp (or gemini-2.5-flash, gemini-pro, etc.) and provide API key
# DATAMETRONOME_ADK_MODEL=gemini-2.0-flash-exp
# DATAMETRONOME_ADK_API_KEY=your-gemini-api-key-here
# Alternative: You can also set GEMINI_API_KEY environment variable directly
# GEMINI_API_KEY=your-gemini-api-key-here
DATAMETRONOME_ADK_API_URL=https://generativelanguage.googleapis.com/v1beta
